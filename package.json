{
  "name": "crypto_payment",
  "version": "1.5.0",
  "description": "Service for processing crypto transactions with multi-send functionality.",
  "main": "dist/index.js",
  "scripts": {
    "lint": "eslint . --ext .js,.ts --cache",
    "lint-fix": "eslint . --ext .js,.ts --fix",
    "app:build": "tsc",
    "app:start": "node dist/app.js",
    "tests:start": "",
    "tests:get-data-from-sheet": "ts-node src/__tests__/utils/get-data-from-sheet.ts 0 cryptoPaymentTestData.json",
    "test:unit": "mocha --no-config --require ts-node/register --require src/__tests__/setup.ts --timeout 60000 --exit \"src/__tests__/unit/**/*.test.ts\" src/__tests__/utils/idempotency.test.ts src/__tests__/utils/evm.test.ts src/__tests__/services/evm.nonce.test.ts",
    "tokens:compile": "node scripts/compile-tokens.js"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "chalk": "^5.5.0",
    "dotenv": "^16.4.5",
    "express": "^4.17.21",
    "node-fetch": "^2.7.0",
    "tronweb": "^6.1.1",
    "viem": "^2.43.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "@types/chai": "^4.3.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.7",
    "@types/node": "^24.19.2",
    "@types/node-fetch": "^2.6.11",
    "chai": "^5.1.1",
    "eslint": "8.22.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.25.2",
    "google-auth-library": "^9.13.0",
    "google-spreadsheet": "^4.1.4",
    "mocha": "^12.0.3",
    "solc": "0.8.28",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.4.0",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "overrides": {
    "axios": "^1.20.0",
    "ws@7": "^7.5.11",
    "ws@8": "^8.21.0",
    "solc": {
      "tmp": "^0.2.6"
    },
    "minimatch@10": "^11.0.5",
    "mocha": {
      "glob": "^14.0.4"
    }
  }
}
